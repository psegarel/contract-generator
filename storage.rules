rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Counterparty documents (renamed from client-documents)
    match /counterparty-documents/{counterpartyId}/{fileName} {
      // Only the owner/admin account can access application documents
      allow read: if isAdmin();

      // Only the owner/admin account can write with size and type restrictions
      allow write: if isAdmin()
        && request.resource.size < 500 * 1024  // 500KB limit
        && request.resource.contentType.matches('image/.*|application/pdf');

      // Only the owner/admin account can delete
      allow delete: if isAdmin();
    }
  }
}
