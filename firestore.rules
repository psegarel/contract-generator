rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // User profiles
    match /users/{userId} {
      // Users can read their own profile
      allow read: if request.auth.uid == userId;

      // Users can create their own profile
      allow create: if request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.isAdmin == false;  // Prevent self-promotion

      // Users cannot update their own admin status
      allow update: if false;
    }

    match /clients/{clientId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: owner/admin only; fields must be valid
      allow create: if isAdmin()
        && ('ownerUid' in request.resource.data)
        && ('name' in request.resource.data && request.resource.data.name is string)
        && ('email' in request.resource.data && request.resource.data.email is string)
        && ('phone' in request.resource.data && request.resource.data.phone is string)
        && ('address' in request.resource.data && request.resource.data.address is string)
        && ('idDocument' in request.resource.data && request.resource.data.idDocument is string)
        && (!('taxId' in request.resource.data)
            || request.resource.data.taxId is string
            || request.resource.data.taxId == null)
        && (!('bankName' in request.resource.data)
            || request.resource.data.bankName is string
            || request.resource.data.bankName == null)
        && (!('accountNumber' in request.resource.data)
            || request.resource.data.accountNumber is string
            || request.resource.data.accountNumber == null);

      // Update: owner/admin only; fields remain valid
      allow update: if isAdmin()
        && ('ownerUid' in request.resource.data)
        && ('name' in request.resource.data ? request.resource.data.name is string : true)
        && ('email' in request.resource.data ? request.resource.data.email is string : true)
        && ('phone' in request.resource.data ? request.resource.data.phone is string : true)
        && ('address' in request.resource.data ? request.resource.data.address is string : true)
        && ('idDocument' in request.resource.data ? request.resource.data.idDocument is string : true)
        && ('taxId' in request.resource.data
            ? (request.resource.data.taxId is string || request.resource.data.taxId == null)
            : true)
        && ('bankName' in request.resource.data
            ? (request.resource.data.bankName is string || request.resource.data.bankName == null)
            : true)
        && ('accountNumber' in request.resource.data
            ? (request.resource.data.accountNumber is string || request.resource.data.accountNumber == null)
            : true);

      // Delete: owner/admin only
      allow delete: if isAdmin();
    }

    match /locations/{locationId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: owner/admin only; fields must be valid
      allow create: if isAdmin()
        && ('ownerUid' in request.resource.data)
        && ('name' in request.resource.data && request.resource.data.name is string)
        && ('address' in request.resource.data && request.resource.data.address is string)
        && (!('contactPerson' in request.resource.data)
            || request.resource.data.contactPerson is string
            || request.resource.data.contactPerson == null)
        && (!('contactEmail' in request.resource.data)
            || request.resource.data.contactEmail is string
            || request.resource.data.contactEmail == null)
        && (!('contactPhone' in request.resource.data)
            || request.resource.data.contactPhone is string
            || request.resource.data.contactPhone == null);

      // Update: owner/admin only; fields remain valid
      allow update: if isAdmin()
        && ('ownerUid' in request.resource.data)
        && ('name' in request.resource.data ? request.resource.data.name is string : true)
        && ('address' in request.resource.data ? request.resource.data.address is string : true)
        && ('contactPerson' in request.resource.data
            ? (request.resource.data.contactPerson is string || request.resource.data.contactPerson == null)
            : true)
        && ('contactEmail' in request.resource.data
            ? (request.resource.data.contactEmail is string || request.resource.data.contactEmail == null)
            : true)
        && ('contactPhone' in request.resource.data
            ? (request.resource.data.contactPhone is string || request.resource.data.contactPhone == null)
            : true);

      // Delete: owner/admin only
      allow delete: if isAdmin();
    }

    match /contracts/{contractId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: owner/admin only; fields must be valid
      allow create: if isAdmin()
        && ('ownerUid' in request.resource.data)
        && ('type' in request.resource.data && request.resource.data.type is string)
        && ('contractData' in request.resource.data && request.resource.data.contractData is map)
        && ('contractNumber' in request.resource.data && request.resource.data.contractNumber is string)
        && ('locationId' in request.resource.data && request.resource.data.locationId is string)
        && ('paymentStatus' in request.resource.data && request.resource.data.paymentStatus is string)
        && ('createdAt' in request.resource.data);

      // Update: owner/admin only
      allow update: if isAdmin()
        && ('ownerUid' in request.resource.data)
        && (
          // Regular update (non-payment fields)
          (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
          // OR admin updating payment status
          || isAdmin()
        );

      // Delete: only admins can delete
      allow delete: if isAdmin();
    }

    match /service-contracts/{contractId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: owner/admin only; fields must be valid
      allow create: if isAdmin()
        && ('ownerUid' in request.resource.data)
        && ('contractData' in request.resource.data && request.resource.data.contractData is map)
        && ('contractNumber' in request.resource.data && request.resource.data.contractNumber is string)
        && ('locationId' in request.resource.data && request.resource.data.locationId is string)
        && ('paymentStatus' in request.resource.data && request.resource.data.paymentStatus is string)
        && ('createdAt' in request.resource.data);

      // Update: owner/admin only
      allow update: if isAdmin()
        && ('ownerUid' in request.resource.data)
        && (
          // Regular update (non-payment fields)
          (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
          // OR admin updating payment status
          || isAdmin()
        );

      // Delete: only admins can delete
      allow delete: if isAdmin();
    }

    match /event-planning-contracts/{contractId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: owner/admin only; fields must be valid
      allow create: if isAdmin()
        && ('ownerUid' in request.resource.data)
        && ('contractData' in request.resource.data && request.resource.data.contractData is map)
        && ('contractNumber' in request.resource.data && request.resource.data.contractNumber is string)
        && ('locationId' in request.resource.data && request.resource.data.locationId is string)
        && ('paymentStatus' in request.resource.data && request.resource.data.paymentStatus is string)
        && ('createdAt' in request.resource.data);

      // Update: owner/admin only
      allow update: if isAdmin()
        && ('ownerUid' in request.resource.data)
        && (
          // Regular update (non-payment fields)
          (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
          // OR admin updating payment status
          || isAdmin()
        );

      // Delete: only admins can delete
      allow delete: if isAdmin();
    }

    // ============================================================
    // App Configuration (shared, non-sensitive config)
    // ============================================================

      // Bank list cache — owner/admin only for this single-owner application.
    match /app-config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // V2 Collections (New Architecture)
    // ============================================================

    // Counterparties (v2) - replaces clients
    match /counterparties/{counterpartyId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: owner/admin only
      allow create: if isAdmin();

      // Update: owner/admin only
      allow update: if isAdmin();

      // Delete: owner/admin only
      allow delete: if isAdmin();
    }

    // Events (v2) - new entity grouping contracts
    match /events/{eventId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: owner/admin only
      allow create: if isAdmin();

      // Update: owner/admin only
      allow update: if isAdmin();

      // Delete: owner/admin only
      allow delete: if isAdmin();
    }

    // Service Provision Contracts (v2) - migrated from service-contracts
    match /service-provision-contracts/{contractId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: owner/admin only
      allow create: if isAdmin();

      // Update: owner/admin only
      allow update: if isAdmin()
        && (
          // Regular update (non-payment fields)
          (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
          // OR admin updating payment status
          || isAdmin()
        );

      // Delete: only admins can delete
      allow delete: if isAdmin();
    }

    // Event Planning Contracts (v2) - migrated from event-planning-contracts
    match /event-planning-contracts/{contractId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: owner/admin only
      allow create: if isAdmin();

      // Update: owner/admin only
      allow update: if isAdmin()
        && (
          // Regular update (non-payment fields)
          (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
          // OR admin updating payment status
          || isAdmin()
        );

      // Delete: only admins can delete
      allow delete: if isAdmin();
    }

    // Payment Records (v2)
    match /payments/{paymentId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: owner/admin only
      allow create: if isAdmin();

      // Update: only admins can update payment status
      allow update: if isAdmin();

      // Delete: only admins can delete
      allow delete: if isAdmin();
    }

    // Equipment Rental Contracts (v2)
    match /equipment-rental-contracts/{contractId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: must be signed-in
      allow create: if isAdmin();

      // Update: owner/admin only
      allow update: if isAdmin()
        && (
          // Regular update (non-payment fields)
          (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
          // OR admin updating payment status
          || isAdmin()
        );

      // Delete: only admins can delete
      allow delete: if isAdmin();
    }

    // Equipment Rental One-Off Contracts (v2)
    match /equipment-rental-oneoff-contracts/{contractId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: owner/admin only
      allow create: if isAdmin();

      // Update: owner/admin only
      allow update: if isAdmin()
        && (
          // Regular update (non-payment fields)
          (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
          // OR admin updating payment status
          || isAdmin()
        );

      // Delete: only admins can delete
      allow delete: if isAdmin();
    }

    // DJ Residency Contracts (v2)
    match /dj-residency-contracts/{contractId} {
      // Only the owner/admin account can access application data
      allow read: if isAdmin();

      // Create: must be signed-in
      allow create: if isAdmin();

      // Update: any authenticated user can update
      // But only admins can update payment status
      allow update: if isAdmin()
        && (
          // Regular update (non-payment fields)
          (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus)
          // OR admin updating payment status
          || isAdmin()
        );

      // Delete: only admins can delete
      allow delete: if isAdmin();

      // Performances subcollection
      match /performances/{performanceId} {
        // Only the owner/admin account can access application data
        allow read: if isAdmin();

        // Owner/admin only can create performance logs
        allow create: if isAdmin();

        // Owner/admin only can update (e.g., mark as invoiced)
        allow update: if isAdmin();

        // Owner/admin only can delete (to correct mistakes)
        // Only uninvoiced performances should be deletable (enforced in app logic)
        allow delete: if isAdmin();
      }

      // Invoices subcollection
      match /invoices/{invoiceId} {
        // Only the owner/admin account can access application data
        allow read: if isAdmin();

        // Owner/admin only can create invoices
        allow create: if isAdmin();

        // Owner/admin only can update (e.g., change status)
        allow update: if isAdmin();

        // Only admins can delete invoices
        allow delete: if isAdmin();
      }
    }
  }
}
